      }
    },
    "Choose whether to help improve Roam Control with anonymous activity counts. Sharing starts only if you switch it on and can be changed later in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以選擇是否以匿名活動次數協助改善 Sprout。只有在你主動開啟後才會開始分享，之後也可以在「設定」中變更。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether to help improve Sprout with anonymous activity counts. Sharing starts only if you switch it on and can be changed later in Settings."
