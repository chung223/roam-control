          }
        }
      }
    },
    "Roam Control uses a narrow first-party sender instead of an analytics SDK, so extra device metadata is not added automatically.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Roam Control 使用範圍狹窄的第一方傳送程式，而非分析 SDK，因此不會自動附加額外的裝置中繼資料。"
          }
        }
      }
    },
