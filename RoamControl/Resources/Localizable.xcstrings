    "Roam Control should continue automatically. If it doesn't, tap Continue.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout 應該會自動繼續。如果沒有，請點一下「繼續」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout should continue automatically. If it doesn't, tap Continue."
          }
        }
      }
    },
    "Roam Control uses a narrow first-party sender instead of an analytics SDK, so extra device metadata is not added automatically.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout 使用範圍狹窄的第一方傳送程式，而非分析 SDK，因此不會自動附加額外的裝置中繼資料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprout uses a narrow first-party sender instead of an analytics SDK, so extra device metadata is not added automatically."
          }
        }
      }
    },
    "Roam Control will end the simulated location and restore this iPhone's real location.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
