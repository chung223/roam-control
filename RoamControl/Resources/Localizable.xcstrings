    "An inactive session means Roam Control's worker has ended. Other apps may need time to acquire a fresh real location.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段未啟用代表 Sprout 的工作程序已結束。其他 App 可能需要一些時間才能取得新的真實位置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An inactive session means Sprout's worker has ended. Other apps may need time to acquire a fresh real location."
