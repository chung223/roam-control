        }
      }
    },
    "The pairing record is generated or checked on this iPhone, then stored only in its Keychain. Roam Control does not upload it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對記錄在這支 iPhone 上產生或驗證，並且只存放在它的鑰匙圈中。Roam Control 不會上傳。"
          }
        }
      }
    },
    "The saved pairing is no longer valid. Reset Device Setup and pair again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
