    "Done": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "E": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "東"
          }
        }
      }
    },
    "Enter the six-digit code in Settings to confirm.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」中輸入六位數驗證碼以確認。"
          }
        }
      }
    },
    "Enter this code in Settings": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」中輸入此驗證碼"
          }
        }
      }
    },
    "Europe": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歐洲"
          }
        }
      }
    },
    "Events are sent to Roam Control's maintainer-operated service and, in configured beta builds, TelemetryDeck. The self-hosted service receives ordinary HTTPS connection metadata, such as the source IP address, but the app does not include it in the event body.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "事件會傳送到由 Roam Control 維護者營運的服務，在有設定的 Beta 版本中也會傳送到 TelemetryDeck。自架服務會收到一般的 HTTPS 連線中繼資料（例如來源 IP 位址），但 App 不會把它放進事件內容中。"
          }
        }
      }
    },
    "Favourites": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏"
          }
        }
      }
    },
    "Favourites and history": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏與紀錄"
          }
        }
      }
    },
    "Feedback": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "意見回饋"
          }
        }
      }
    },
    "Finding This iPhone…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在尋找這支 iPhone…"
          }
        }
      }
    },
    "Finding the paired iPhone through the private local tunnel.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在透過私有本機隧道尋找已配對的 iPhone。"
          }
        }
      }
    },
    "Finish in Settings": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往「設定」完成"
          }
        }
      }
    },
    "Finishing pairing": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在完成配對"
          }
        }
      }
    },
    "Follow the mobile-data guidance if it appears.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若出現行動網路的指引，請依照指引操作。"
          }
        }
      }
    },
    "Get LocalDevVPN": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取得 LocalDevVPN"
          }
        }
      }
    },
    "GitHub may ask you to choose Bug Report or Feature Request first. For pairing or connection problems, open Connection Health and use Copy Diagnostics. Do not include pairing records, credentials or private locations.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 可能會先請你選擇「Bug Report」或「Feature Request」。若是配對或連線問題，請開啟「連線健康狀態」並使用「複製診斷資訊」。請勿附上配對記錄、憑證或私人位置。"
          }
        }
      }
    },
    "Give this saved place a name that is easy to recognise.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為這個已儲存的地點取一個好辨認的名稱。"
          }
        }
      }
    },
    "History": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史紀錄"
          }
        }
      }
    },
    "How it works": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "運作方式"
          }
        }
      }
    },
    "Hybrid": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "混合"
          }
        }
      }
    },
    "I'm Using Mobile Data": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我正在使用行動網路"
          }
        }
      }
    },
    "If you're on Wi‑Fi, make sure LocalDevVPN says Connected, then try again. Choose mobile data only when you're actually using 4G or 5G.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你正在使用 Wi‑Fi，請確認 LocalDevVPN 顯示為 Connected，然後再試一次。只有在你確實使用 4G 或 5G 時才選擇行動網路。"
          }
        }
      }
    },
    "Import Existing File": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入現有檔案"
          }
        }
      }
    },
    "Install %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝 %@"
          }
        }
      }
    },
    "Install LocalDevVPN before starting a location session.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動定位工作階段前，請先安裝 LocalDevVPN。"
          }
        }
      }
    },
    "Keep Recovery Options": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留復原選項"
          }
        }
      }
    },
    "Keep Roam Control open until the real location has been restored.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "真實位置還原完成前，請保持 Roam Control 開啟。"
          }
        }
      }
    },
    "Keep Roam Control running. You can use other apps while the walk continues.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請讓 Roam Control 持續執行。步行進行期間你可以使用其他 App。"
          }
        }
      }
    },
    "Keep Simulated Location": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持模擬定位"
          }
        }
      }
    },
    "Landmarks": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地標"
          }
        }
