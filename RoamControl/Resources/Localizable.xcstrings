    "The pairing record is generated or checked on this iPhone, then stored only in its Keychain. Roam Control does not upload it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對記錄在這支 iPhone 上產生或驗證，並且只存放在它的鑰匙圈中。Sprout 不會上傳。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pairing record is generated or checked on this iPhone, then stored only in its Keychain. Sprout does not upload it."
          }
