    "Closing the local session and advertisement.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在關閉本機工作階段與廣播。"
          }
        }
      }
    },
    "Connect your physical iPhone to create the pairing, or import an existing file.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接你的實體 iPhone 以建立配對，或匯入現有檔案。"
          }
        }
      }
    },
    "Connecting…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線中…"
          }
        }
      }
    },
    "Connection Check": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線檢查"
          }
        }
      }
    },
    "Connection Health": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線健康狀態"
          }
        }
      }
    },
    "Connection error": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線錯誤"
          }
        }
      }
    },
    "Connection status: %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線狀態：%@"
          }
        }
      }
    },
    "Continue": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續"
          }
        }
      }
    },
    "Copies a status-only report you can paste into a bug report. It never includes locations, searches, pairing records, PINs, device names or error text.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製一份僅含狀態的報告，可貼進問題回報。其中絕不包含位置、搜尋內容、配對記錄、PIN、裝置名稱或錯誤文字。"
          }
        }
      }
    },
    "Couldn’t check GitHub right now. Try again later.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法檢查 GitHub，請稍後再試。"
          }
        }
      }
    },
    "Create the pairing securely on this iPhone, or import an existing file.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這支 iPhone 上安全地建立配對，或匯入現有檔案。"
          }
        }
      }
    },
    "Currently using %@. Update to move to %@.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前使用 %1$@。更新即可移動到 %2$@。"
          }
        }
      }
    },
