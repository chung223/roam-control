      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在偵測這支 iPhone…"
          }
        }
      }
    },
    "Device Setup": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
