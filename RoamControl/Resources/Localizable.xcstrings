{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@, %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$@"
          }
        }
      }
    },
    "%@. %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。%2$@"
          }
        }
      }
    },
    "A newer public release is available: %@.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有可用的新版公開發行版本：%@。"
          }
        }
      }
    },
    "A random identifier is created for this installation and irreversibly hashed before it is sent. It is used only to estimate activity from participating installations.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統會為這次安裝建立一個隨機識別碼，並在傳送前經過不可逆的雜湊處理。它只用於估算參與安裝的活動量。"
          }
        }
      }
    },
    "A real iPhone is required to start a location session.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要實體 iPhone 才能啟動定位工作階段。"
          }
        }
      }
    },
    "About Roam Control": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於 Roam Control"
          }
        }
      }
    },
    "Africa": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "非洲"
          }
        }
      }
    },
    "An inactive session means Roam Control's worker has ended. Other apps may need time to acquire a fresh real location.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段未啟用代表 Roam Control 的工作程序已結束。其他 App 可能需要一些時間才能取得新的真實位置。"
          }
        }
      }
    },
    "Anonymous Statistics": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名統計"
          }
        }
      }
    },
    "Another VPN may affect local device connections. If it is appropriate for your network, compare a test with that VPN paused. Keep LocalDevVPN enabled when starting a location session.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他 VPN 可能影響本機裝置連線。若你的網路環境允許，可以暫停該 VPN 再測試比較。啟動定位工作階段時請保持 LocalDevVPN 啟用。"
          }
        }
      }
    },
    "Asia": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "亞洲"
          }
        }
      }
    },
    "Auto": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動"
          }
        }
      }
    },
    "Automatic": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動"
          }
        }
      }
    },
    "Before connecting": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線之前"
          }
        }
      }
    },
    "Brisk": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快走"
          }
        }
      }
    },
    "Browse well-known places": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽知名地標"
          }
        }
      }
    },
    "Cancel": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Cancel Pairing": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消配對"
          }
        }
      }
    },
    "Cancel Restoration": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消還原"
          }
        }
      }
    },
    "Checking pairing file": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查配對檔案"
          }
        }
      }
    },
    "Checking this iPhone": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查這支 iPhone"
          }
        }
      }
    },
    "Checks the public GitHub release only when you tap it. Roam Control never sends location, pairing or diagnostic data with this request.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你點選時才會檢查公開的 GitHub 版本。Roam Control 不會在這個請求中傳送位置、配對或診斷資料。"
          }
        }
      }
    },
    "Choose a location": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個位置"
          }
        }
      }
    },
    "Choose where your iPhone should appear, from one simple map.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在一張簡潔的地圖上，決定你的 iPhone 要出現在哪裡。"
          }
        }
      }
    },
    "Choose whether to help improve Roam Control with anonymous activity counts. Sharing starts only if you switch it on and can be changed later in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以選擇是否以匿名活動次數協助改善 Roam Control。只有在你主動開啟後才會開始分享，之後也可以在「設定」中變更。"
          }
        }
      }
    },
    "Choose, test and move this iPhone’s reported location from one clean map.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在一張簡潔的地圖上選擇、測試並移動這支 iPhone 回報的位置。"
          }
        }
      }
    },
    "Clear": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除"
          }
        }
      }
    },
    "Clear search": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除搜尋"
          }
        }
      }
    },
    "Clear selected location": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除已選位置"
          }
        }
      }
    },
    "Close introduction": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉介紹"
          }
        }
      }
    },
    "Close walking route": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉步行路線"
          }
