# macOS
.DS_Store

# Xcode user-specific data
xcuserdata/
*.xcuserstate

# Xcode build output
DerivedData/
build/

# Swift Package Manager
.build/
.swiftpm/xcode/package.xcworkspace/xcuserdata/

# Archives / signing
*.xcarchive
*.ipa
*.mobileprovision
*.p12
*.cer
*.pem
*.key

