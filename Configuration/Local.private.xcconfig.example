// Copy this file to Local.private.xcconfig and fill in only the values needed
// for your own build. Local.private.xcconfig is ignored by Git.
DEVELOPMENT_TEAM = YOUR-APPLE-DEVELOPMENT-TEAM-ID
// Set this when signing with your own team and your own App ID. The Live
// Activity extension follows it automatically.
ROAMCONTROL_BUNDLE_ID = com.example.roamcontrol
ROAMCONTROL_TELEMETRY_APP_ID = YOUR-TELEMETRYDECK-APP-ID
ROAMCONTROL_TELEMETRY_NAMESPACE = your.namespace
ROAMCONTROL_SELFHOSTED_TELEMETRY_TOKEN = YOUR-SELF-HOSTED-INGESTION-TOKEN
